  "dictation.enabled": true,

  // Experimental: when dictation ends, the final transcript is passed through a small language model to restore punctuation, capitalization, paragraphs, and lists. Requires Copilot to be enabled; the transcript is sent to the language model for cleanup. Falls back to the raw transcript when no model is available. Use [dictation instructions](command:workbench.action.chat.configureDictationInstructions) to customize terminology and formatting.
  "dictation.experimental.llmCleanup": true,

