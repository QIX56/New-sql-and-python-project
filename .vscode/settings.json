  "inlineChat.fixDiagnostics": true,

  // Enable agent-like behavior for inline chat widget in notebooks.
  "inlineChat.notebookAgent": false

},
{
  // Chat Agent Host
  // When enabled, new editor and panel chat sessions default to the Agent Host Copilot SDK instead of the local harness.
  "chat.defaultToCopilotHarness": false,

  // When enabled, shows the VS Code local chat harness in the chat picker. This setting is ignored in virtual workspaces, where the local chat harness is always available.
  "chat.editor.localAgent.enabled": true,

  // When enabled, uses the Agent Host Copilot SDK whenever the local harness would otherwise be selected for a new editor chat session. Claude and Codex selections are unaffected.
  "chat.editor.preferCopilotHarness": false

},
{
  // Chat Agent Host Starter
  // When enabled, extension-provided BYOK ('bring your own key') models can run in agent-host sessions. Changes are synchronized to the running agent host and do not require a restart.
  "chat.agentHost.byokModels.enabled": true,

  // When enabled, the agent host registers the Claude provider, subject to the Claude SDK being reachable. The agent host process must be restarted for changes to take effect.
  "chat.agentHost.claudeAgent.enabled": true,

  // When enabled, the agent host registers the Codex provider (subject to the Codex SDK being reachable). Enabling takes effect without restarting the agent host.
  "chat.agentHost.codexAgent.enabled": false,

  // When enabled, agent-host sessions include the GitHub MCP server.
  "chat.agentHost.githubMcpServer.enabled": true,

  // When enabled, Copilot sessions automatically discover and use the operating system's proxy configuration when no proxy environment variable is set.
  "chat.agentHost.systemProxy.enabled": true

},
{
  // Controls whether the current prompt is pinned to the top of the chat transcript while scrolling.
  "chat.stickyScroll.enabled": true

},
{
  // Multi Diff Editor
  // Controls the experimental variant of the multi diff editor.
  //  - cards: Use the compact card-based variant.
  //  - noCards: Use the compact variant without cards.
  "multiDiffEditor.experimental.variant": "noCards"

},
{
  // Controls how the prompt timeline is displayed next to the chat transcript in the Agents window.
  //  - off: Do not show the prompt timeline.
  //  - ruler: Show an overview ruler beside the transcript scrollbar that fans into prompt pills on engagement.
  //  - gutter: Show a minimal handle in the transcript's left gutter that opens a list of prompts on hover.
  "sessions.chatTimeline.display": "gutter"

},
{
  // Chat
  // When applying edits, show a progress animation in the code block pill. If disabled, shows the progress percentage instead.
  "chat.agent.codeBlockProgress": true,

  // Controls whether completed chat responses collapse intermediate work while keeping the final response visible.
  "chat.agent.collapseCompletedResponses": true,

  // When enabled, agent mode can be activated from chat and tools in agentic contexts with side effects can be used.
  "chat.agent.enabled": true,

  // The maximum number of requests to allow per-turn when using an agent. When the limit is reached, will ask to confirm to continue.
  "chat.agent.maxRequests": 50,

  // Controls how tool calls are displayed in relation to thinking sections.
  //  - off: Tool calls are shown separately, not collapsed into thinking.
  //  - withThinking: Tool calls are collapsed into thinking sections when thinking is present.
  //  - always: Tool calls are always collapsed, even without thinking.
  "chat.agent.thinking.collapsedTools": "always",

  // Controls whether to use an LLM to generate summary titles for thinking sections.
  "chat.agent.thinking.generateTitles": true,

  // Customize the loading messages shown during agent thinking and progress indicators. Use `"mode": "replace"` to use only your phrases, or `"mode": "append"` to add them to the defaults.
  "chat.agent.thinking.phrases": {
    "mode": "append",
    "phrases": []
  },

  // When enabled, terminal tool calls are displayed inside the thinking dropdown with a simplified view.
  "chat.agent.thinking.terminalTools": true,

  // Controls how thinking is rendered. Read-only chats always use the collapsed preview style.
  //  - collapsed: Thinking parts will be collapsed by default.
  //  - collapsedPreview: Thinking parts will be expanded first, then collapse once we reach a part that is not thinking.
  //  - fixedScrolling: Show thinking in a fixed-height streaming panel that auto-scrolls; click header to expand to full height.
  "chat.agent.thinkingStyle": "fixedScrolling",

  // This setting and the Local agent harness will be removed in a future release. Use [Migrate Location Settings](command:aiCustomization.openManagementEditor?%255B%257B%2522migration%2522%253Atrue%252C%2522migrationCategory%2522%253A%2522configuredLocations%2522%257D%255D "Open Migrate Location Settings") in the Agent Customizations editor to move agents into supported locations.
  // Specify location(s) of custom agent files (`*.agent.md`). [Learn More](https://aka.ms/vscode-ghcp-custom-chat-modes).
  // 
  // Relative paths are resolved from the root folder(s) of your workspace.
  // 
  // This setting is only used by the Local agent harness.
  "chat.agentFilesLocations": {
    ".github/agents": true,
    ".claude/agents": true,
    "~/.copilot/agents": true
  },

  // Enable agent debug logging for agent host sessions: surface their debug events in the agent debug panel. Takes effect immediately; only sessions that run while this is enabled are captured.
  "chat.agentHost.agentDebugLog.enabled": false,

  // Maximum number of debug events kept in memory per agent host session for the agent debug panel. Older events beyond this limit are dropped from the in-memory buffer, which also lowers the totals (such as token usage) shown in the panel overview.
  "chat.agentHost.agentDebugLog.maxEventsInMemory": 10000,

  // When enabled, logs all AHP transport messages for agent host connections to JSONL files under the window's log directory.
  "chat.agentHost.ahpJsonlLoggingEnabled": false,

  // Overrides the reasoning effort for Copilot SDK agent sessions regardless of the per-model picker value. Set it to a level the selected model supports (for example `low`, `medium`, `high`, or `xhigh`) — choosing a level the model does not support may be rejected by the model. A value that isn't a recognized effort level is ignored and the session falls back to the picker value. Applied when a session is created and when its model changes. Only affects Copilot CLI agent sessions.
  // 
  // **Note**: This is an advanced setting for experimentation.
  "chat.agentHost.copilot.reasoningEffortOverride": "",

  // Minimum number of tools before MCP and external tools are deferred behind tool search. Set to 0 to always defer external tools. Only effective when tool search is enabled.
  "chat.agentHost.copilot.toolSearch.deferThreshold": 1,

  // When enabled, Copilot SDK sessions defer MCP and non-core VS Code tools behind a tool-search tool so the model discovers them on demand instead of loading every tool definition up front.
  "chat.agentHost.copilot.toolSearch.enabled": true,

  // When enabled, Copilot SDK sessions use the Agent Host terminal tool override instead of the SDK's default terminal behavior.
  "chat.agentHost.customTerminalTool.enabled": false,

  // When enabled, Copilot SDK sessions running a Claude Opus 4.8 model apply Opus 4.8-tuned system-prompt section overrides on top of the default system message.
  "chat.agentHost.opus48Prompt.enabled": false,

  // This setting no longer has any effect. Use `chat.agent.sandbox.enabled` for both the SDK's built-in shell tool and the Agent Host's custom terminal tool.
  // Deprecated sandbox mode for the Copilot SDK's built-in shell tool on macOS and Linux.
  "chat.agentHost.sdkSandbox.enabled": "off",

  // This setting no longer has any effect. Use `chat.agent.sandbox.enabledWindows` for both the SDK's built-in shell tool and the Agent Host's custom terminal tool.
  // Deprecated sandbox mode for the Copilot SDK's built-in shell tool on Windows.
  "chat.agentHost.sdkSandbox.enabledWindows": "off",

  // Controls how the 'Agent Status' indicator appears in the title bar command center. When set to `hidden`, the indicator is not shown. Other values show the indicator and automatically enable `window.commandCenter`. The unread and in-progress session indicators require `chat.viewSessions.enabled` to be enabled.
  //  - hidden: The agent status indicator is hidden from the title bar.
  //  - badge: Shows the agent status as a badge next to the command center.
  //  - compact: Replaces the command center search box with a compact agent status indicator and unified chat widget.
  "chat.agentsControl.enabled": "compact",

  // Controls whether Agent Session Projection mode is enabled for reviewing agent sessions in a focused workspace.
  "chat.agentSessionProjection.enabled": false,

  // Controls which external agent sessions, created outside VS Code's Agent Host, are shown.
  //  - none: Do not show external sessions.
  //  - recent: Show up to the 2 most recent external sessions updated in the last 7 days. At startup, external sessions older than the second-most-recently updated local session are hidden.
  //  - last24Hours: Show external sessions updated in the last 24 hours.
  //  - last7Days: Show external sessions updated in the last 7 days.
  //  - last30Days: Show external sessions updated in the last 30 days.
  "chat.agentSessions.showExternal": "recent",

  // Controls the delay, in seconds, after the latest user message before offering to continue an in-progress session in the Agents Window. Requires `chat.agentsHandoffTip.mode` to be `default` or `custom`.
  "chat.agentsHandoffTip.delaySeconds": 5,

  // Controls the tip shown above the chat input offering to continue eligible agent sessions in the Agents Window.
  //  - hidden: Never show the handoff tip.
  //  - default: Show the handoff tip with the default description.
  //  - custom: Show the handoff tip with an alternate description.
  "chat.agentsHandoffTip.mode": "hidden",

  // This setting and the Local agent harness will be removed in a future release. Use [Migrate Location Settings](command:aiCustomization.openManagementEditor?%255B%257B%2522migration%2522%253Atrue%252C%2522migrationCategory%2522%253A%2522configuredLocations%2522%257D%255D "Open Migrate Location Settings") in the Agent Customizations editor to move skills into supported locations.
  // Specify location(s) of agent skills (`SKILL.md`) that can be used in Chat Sessions. [Learn More](https://aka.ms/vscode-agent-skills).
  // 
  // Each path should contain skill subfolders with SKILL.md files (e.g., add `my-skills` if you have `my-skills/skillA/SKILL.md`). Relative paths are resolved from the root folder(s) of your workspace.
  // 
  // This setting is only used by the Local agent harness.
  "chat.agentSkillsLocations": {
    ".agents/skills": true,
    ".github/skills": true,
    ".claude/skills": true,
    "~/.agents/skills": true,
    "~/.copilot/skills": true,
